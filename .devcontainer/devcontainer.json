{
	"name": "Ubuntu",
	"image": "mcr.microsoft.com/devcontainers/base:resolute",
	"features": {
		"ghcr.io/shyim/devcontainers-features/bun:0": {}
	},
	"mounts": [
		// Git config của host (chỉ đọc)
		"source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,readonly",
		// known_hosts để không bị hỏi xác nhận host lần đầu
		"source=${localEnv:HOME}/.ssh/known_hosts,target=/home/vscode/.ssh/known_hosts,type=bind,readonly"
	],
	"forwardPorts": []
}